# Python bytecode / caches
__pycache__/
*.py[cod]

# Local runtime state (the hub keeps these outside the repo by default, but a
# run from the checkout can drop them here)
*.db
*.db-wal
*.db-shm

# Desktop build output
desktop/target/

# Android signing material — never commit. The keystore is the app's identity:
# anyone holding it (and its password) can sign updates Android accepts as you.
*.keystore
*.jks
signing-key-info.txt

# Editor / OS noise
.DS_Store
*~
